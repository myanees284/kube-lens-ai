{
  "name": "@kube-lens/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "pnpm --filter @kube-lens/contracts build",
    "dev": "node --watch --experimental-strip-types --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "collect-evidence": "node --experimental-strip-types src/scripts/collect-evidence.ts",
    "setup-mongodb": "node --experimental-strip-types --env-file=../../.env src/scripts/setup-mongodb.ts",
    "seed-knowledge": "node --experimental-strip-types --env-file=../../.env src/scripts/seed-knowledge.ts",
    "retrieve-check": "node --experimental-strip-types --env-file=../../.env src/scripts/retrieve-check.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@huggingface/transformers": "3.8.1",
    "@kube-lens/contracts": "workspace:*",
    "@kubernetes/client-node": "^2.0.1",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.6.0",
    "groq-sdk": "^1.6.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
