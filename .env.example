# Copy to .env and replace every placeholder. Never commit .env.

# API bind. Keep the default unless you intentionally expose the process.
APP_HOST=127.0.0.1
APP_PORT=3001

# Shared local API key. At least 16 characters. The frontend must not embed this value.
APP_API_KEY=replace-with-a-local-api-key

# Browser origin allowed by CORS. Match the Vite dev server.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# MongoDB Atlas connection string for a non-production database.
MONGODB_URI=replace-with-mongodb-uri
MONGODB_DATABASE=k8s_KBase

# Groq credential and model id. Confirm the model id against your Groq account.
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=replace-with-groq-model

# Local embedding baseline from the architecture. Dimension must match the model.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Optional namespace used only when a request omits scope. Leave empty to require explicit scope.
DEFAULT_NAMESPACE=

MAX_LOG_LINES=200
MAX_EVENTS=100
MAX_EVIDENCE_CHARS=20000
MAX_TIMELINE_EVENTS=100
RAG_INCIDENT_CANDIDATES=5
# Reciprocal rank fusion constant. This is not a similarity probability.
RAG_RRF_K=60
# Leave empty until the RRF threshold is calibrated. An empty value never auto-selects a historical RCA.
RAG_INCIDENT_MIN_SCORE=
LLM_TIMEOUT_MS=30000
LOG_LEVEL=info
